---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import EspacioCard from '../../components/EspacioCard.astro';
import { url } from '../../lib/url';

const espacios = await getCollection('espacios', ({ data }) => !data.draft);
const destacados = espacios
  .filter((e) => e.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 6);

const pasos = [
  {
    icon: 'lucide:search',
    title: 'Tell us what you need',
    text: 'Area, type of space and team size. Or browse the catalogue directly.',
  },
  {
    icon: 'lucide:handshake',
    title: 'We connect you',
    text: 'We filter the available spaces and put you in touch with the ones that fit.',
  },
  {
    icon: 'lucide:key-round',
    title: 'You close the deal',
    text: 'Visit, negotiate and sign. We accompany you through the whole process.',
  },
];
---

<Base
  title="Tenerife Coworking · Workspace rentals in the Canary Islands"
  description="Brokerage for offices, meeting rooms, retail spaces and coworking desks across all the Canary Islands. Find your space or list yours."
  lang="en"
  altHref={url('')}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-100 via-[var(--surface)] to-[var(--surface)]"
    >
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-400/20 text-brand-700 text-sm font-semibold mb-6"
        >
          <Icon name="lucide:map-pin" class="w-4 h-4" />
          All the Canary Islands
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-[var(--text)] leading-[1.05] mb-6">
          Your next workspace,
          <span class="text-brand-500">one click away.</span>
        </h1>
        <p class="text-lg sm:text-xl text-[var(--text-soft)] max-w-2xl mb-8">
          Offices, meeting rooms, retail spaces and coworking desks across all
          the islands. We help you find the perfect spot — or rent out yours.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={url('en/spaces')}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-brand-400 text-[var(--on-accent)] font-bold transition hover:bg-brand-300"
          >
            <Icon name="lucide:search" class="w-5 h-5" />
            Find a space
          </a>
          <a
            href={url('en/list-your-space')}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] font-bold transition hover:border-brand-400"
          >
            <Icon name="lucide:plus-circle" class="w-5 h-5" />
            List my space
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured spaces -->
  {
    destacados.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
        <div class="flex items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="text-3xl font-bold text-[var(--text)] mb-2">Featured spaces</h2>
            <p class="text-[var(--text-muted)]">
              A selection of what's available right now. Listings are in Spanish for the time being.
            </p>
          </div>
          <a
            href={url('en/spaces')}
            class="hidden sm:inline-flex items-center gap-1 text-[var(--accent-strong)] font-semibold hover:gap-2 transition-all"
          >
            View all
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {destacados.map((espacio) => (
            <EspacioCard espacio={espacio} lang="en" />
          ))}
        </div>
      </section>
    )
  }

  <!-- How it works -->
  <section class="bg-[var(--surface-2)] border-y border-[var(--card-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="text-3xl font-bold text-[var(--text)] text-center mb-3">How it works</h2>
      <p class="text-[var(--text-muted)] text-center max-w-xl mx-auto mb-12">
        We're brokers: we save you the search and only charge a commission when
        the rental closes.
      </p>
      <div class="grid md:grid-cols-3 gap-8">
        {
          pasos.map((p, i) => (
            <div class="relative flex flex-col items-center text-center">
              <div class="grid place-items-center w-14 h-14 rounded-2xl bg-brand-400 text-[var(--on-accent)] mb-4">
                <Icon name={p.icon} class="w-7 h-7" />
              </div>
              <span class="absolute -top-2 right-1/2 translate-x-12 text-5xl font-extrabold text-brand-400/15">
                {i + 1}
              </span>
              <h3 class="font-bold text-lg text-[var(--text)] mb-2">{p.title}</h3>
              <p class="text-sm text-[var(--text-muted)] max-w-xs">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Owners CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-400 to-brand-500 px-8 py-14 sm:px-14"
    >
      <div class="relative max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-ink-900 mb-4">
          Got an unused space?
        </h2>
        <p class="text-ink-900/80 text-lg mb-8">
          List it for free. We only charge a commission when we get it rented.
          No fees, no lock-in.
        </p>
        <a
          href={url('en/list-your-space')}
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-ink-900 text-white font-bold transition hover:bg-ink-800"
        >
          <Icon name="lucide:plus-circle" class="w-5 h-5" />
          List my space
        </a>
      </div>
      <Icon
        name="lucide:building-2"
        class="absolute -right-8 -bottom-8 w-56 h-56 text-ink-900/10"
      />
    </div>
  </section>
</Base>
