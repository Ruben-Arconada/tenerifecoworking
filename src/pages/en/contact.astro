---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { url } from '../../lib/url';
---

<Base
  title="Contact"
  description="Get in touch with Tenerife Coworking. We help you find your workspace on any of the Canary Islands."
  lang="en"
  altHref={url('contacto')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Info -->
      <div>
        <h1 class="text-4xl font-extrabold text-[var(--text)] mb-4">Let's talk</h1>
        <p class="text-lg text-[var(--text-soft)] mb-8">
          Looking for a space, want to list yours, or have any questions?
          Write to us and we'll get back to you as soon as possible.
        </p>

        <div class="space-y-4">
          <a
            href="mailto:info@tenerifecoworking.es"
            class="flex items-center gap-4 p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card)] hover:border-brand-400 transition"
          >
            <div class="grid place-items-center w-11 h-11 rounded-xl bg-brand-400/20 text-brand-600">
              <Icon name="lucide:mail" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)]">Email</p>
              <p class="font-semibold text-[var(--text)]">info@tenerifecoworking.es</p>
            </div>
          </a>

          <div class="flex items-center gap-4 p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card)]">
            <div class="grid place-items-center w-11 h-11 rounded-xl bg-brand-400/20 text-brand-600">
              <Icon name="lucide:map-pin" class="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs text-[var(--text-muted)]">Service area</p>
              <p class="font-semibold text-[var(--text)]">All the Canary Islands</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="rounded-3xl border border-[var(--card-border)] bg-[var(--card)] p-6 sm:p-8">
        <LeadForm tipo="inquilino" cta="Send message" lang="en" />
      </div>
    </div>
  </div>
</Base>
