---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../../layouts/Base.astro';
import EspacioCard from '../../../components/EspacioCard.astro';
import { url } from '../../../lib/url';
import { ISLAS, TIPOS, TIPO_LABEL_EN } from '../../../content.config';

const espacios = (await getCollection('espacios', ({ data }) => !data.draft)).sort(
  (a, b) => {
    if (a.data.disponible !== b.data.disponible) return a.data.disponible ? -1 : 1;
    return a.data.orden - b.data.orden;
  },
);

const islasConEspacios = ISLAS.filter((isla) =>
  espacios.some((e) => e.data.isla === isla),
);
const tiposConEspacios = TIPOS.filter((tipo) =>
  espacios.some((e) => e.data.tipo === tipo),
);
---

<Base
  title="Spaces for rent in the Canary Islands"
  description="Browse offices, meeting rooms, retail spaces and coworking desks available across the Canary Islands. Filter by island and type."
  lang="en"
  altHref={url('espacios')}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-extrabold text-[var(--text)] mb-3">Available spaces</h1>
      <p class="text-[var(--text-muted)]" aria-live="polite">
        <span id="count">{espacios.length}</span><span
          id="count-noun"
          data-singular=" space"
          data-plural=" spaces">{espacios.length === 1 ? ' space' : ' spaces'}</span> in the Canary Islands.
        <span class="block text-xs mt-1">Listings are published in Spanish for the time being.</span>
      </p>
    </header>

    <!-- Filters -->
    <div class="flex flex-wrap gap-3 mb-8 p-4 rounded-2xl bg-[var(--surface-2)] border border-[var(--card-border)]">
      <div class="flex flex-col gap-1.5 flex-1 min-w-[160px]">
        <label for="f-isla" class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wide">Island</label>
        <select
          id="f-isla"
          class="px-3.5 py-2.5 rounded-lg border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] focus:border-brand-400 transition"
        >
          <option value="">All islands</option>
          {islasConEspacios.map((isla) => <option value={isla}>{isla}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[160px]">
        <label for="f-tipo" class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wide">Type</label>
        <select
          id="f-tipo"
          class="px-3.5 py-2.5 rounded-lg border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] focus:border-brand-400 transition"
        >
          <option value="">All types</option>
          {tiposConEspacios.map((tipo) => <option value={tipo}>{TIPO_LABEL_EN[tipo]}</option>)}
        </select>
      </div>
      <div class="flex items-end">
        <button
          id="f-reset"
          type="button"
          class="px-4 py-2.5 rounded-lg text-sm font-medium text-[var(--text-soft)] hover:bg-[var(--card)] transition"
        >
          Clear
        </button>
      </div>
    </div>

    <!-- Grid -->
    <h2 class="sr-only">Space listings</h2>
    <div id="grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        espacios.map((espacio) => (
          <div class="espacio-item" data-isla={espacio.data.isla} data-tipo={espacio.data.tipo}>
            <EspacioCard espacio={espacio} lang="en" />
          </div>
        ))
      }
    </div>

    <!-- No results -->
    <div id="empty" class="hidden text-center py-20">
      <Icon aria-hidden="true" name="lucide:search-x" class="w-12 h-12 mx-auto text-[var(--text-muted)] mb-4" />
      <p class="text-[var(--text-soft)] font-medium mb-1">No spaces match those filters.</p>
      <p class="text-sm text-[var(--text-muted)]">Try removing a filter or clear the search.</p>
    </div>
  </div>
</Base>

<script>
  import { initCatalog } from '../../../scripts/catalog';
  initCatalog();
</script>
