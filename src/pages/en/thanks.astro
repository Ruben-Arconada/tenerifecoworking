---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
---

<Base
  title="Thank you!"
  description="We've received your message."
  noindex={true}
  lang="en"
  altHref={url('gracias')}
>
  <div class="max-w-xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="grid place-items-center w-20 h-20 mx-auto rounded-full bg-brand-400/20 text-brand-600 mb-6">
      <Icon name="lucide:check-circle-2" class="w-10 h-10" />
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text)] mb-4">Message received!</h1>
    <p class="text-lg text-[var(--text-soft)] mb-8">
      Thanks for writing. We'll reply as soon as possible to the email you gave
      us.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={url('en')}
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-brand-400 text-[var(--on-accent)] font-bold transition hover:bg-brand-300"
      >
        <Icon name="lucide:home" class="w-5 h-5" />
        Back to home
      </a>
      <a
        href={url('en/spaces')}
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] font-bold transition hover:border-brand-400"
      >
        Keep browsing spaces
      </a>
    </div>
  </div>
</Base>
