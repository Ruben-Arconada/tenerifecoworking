---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import EspacioCard from '../components/EspacioCard.astro';
import { url } from '../lib/url';

const espacios = await getCollection('espacios', ({ data }) => !data.draft);
const destacados = espacios
  .filter((e) => e.data.destacado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 6);

const pasos = [
  {
    icon: 'lucide:search',
    title: 'Cuéntanos qué buscas',
    text: 'Dinos zona, tipo de espacio y para cuántas personas. O explora el catálogo directamente.',
  },
  {
    icon: 'lucide:handshake',
    title: 'Te conectamos',
    text: 'Filtramos entre los espacios disponibles y te ponemos en contacto con los que encajan.',
  },
  {
    icon: 'lucide:key-round',
    title: 'Cierras el alquiler',
    text: 'Visitas, negocias y firmas. Nosotros te acompañamos en todo el proceso.',
  },
];
---

<Base
  title="Tenerife Coworking · Alquiler de espacios en Canarias"
  description="Intermediación en alquiler de oficinas, salas, locales y coworkings en todas las islas Canarias. Encuentra tu espacio o publica el tuyo."
  altHref={url('en')}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-100 via-[var(--surface)] to-[var(--surface)]"
    >
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-400/20 text-brand-800 text-sm font-semibold mb-6"
        >
          <Icon aria-hidden="true" name="lucide:map-pin" class="w-4 h-4" />
          Todas las islas Canarias
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-[var(--text)] leading-[1.05] mb-6">
          Tu próximo espacio de trabajo,
          <span class="text-[var(--accent-strong)]">a un clic.</span>
        </h1>
        <p class="text-lg sm:text-xl text-[var(--text-soft)] max-w-2xl mb-8">
          Oficinas, salas de reuniones, locales y puestos de coworking en todas
          las islas. Te ayudamos a encontrar el sitio perfecto — o a alquilar el
          tuyo.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={url('espacios')}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-brand-400 text-[var(--on-accent)] font-bold transition hover:bg-brand-300"
          >
            <Icon aria-hidden="true" name="lucide:search" class="w-5 h-5" />
            Buscar espacio
          </a>
          <a
            href={url('publica-tu-espacio')}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] font-bold transition hover:border-brand-400"
          >
            <Icon aria-hidden="true" name="lucide:plus-circle" class="w-5 h-5" />
            Publicar mi espacio
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Espacios destacados -->
  {
    destacados.length > 0 && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
        <div class="flex items-end justify-between gap-4 mb-8">
          <div>
            <h2 class="text-3xl font-bold text-[var(--text)] mb-2">Espacios destacados</h2>
            <p class="text-[var(--text-muted)]">Una selección de lo que tenemos disponible ahora.</p>
          </div>
          <a
            href={url('espacios')}
            class="hidden sm:inline-flex items-center gap-1 text-[var(--accent-strong)] font-semibold hover:gap-2 transition-all"
          >
            Ver todos
            <Icon aria-hidden="true" name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {destacados.map((espacio) => (
            <EspacioCard espacio={espacio} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Cómo funciona -->
  <section class="bg-[var(--surface-2)] border-y border-[var(--card-border)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="text-3xl font-bold text-[var(--text)] text-center mb-3">Cómo funciona</h2>
      <p class="text-[var(--text-muted)] text-center max-w-xl mx-auto mb-12">
        Somos intermediarios: te ahorramos la búsqueda y solo cobramos comisión
        cuando se cierra el alquiler.
      </p>
      <div class="grid md:grid-cols-3 gap-8">
        {
          pasos.map((p, i) => (
            <div class="relative flex flex-col items-center text-center">
              <div class="grid place-items-center w-14 h-14 rounded-2xl bg-brand-400 text-[var(--on-accent)] mb-4">
                <Icon aria-hidden="true" name={p.icon} class="w-7 h-7" />
              </div>
              <span class="absolute -top-2 right-1/2 translate-x-12 text-5xl font-extrabold text-brand-400/15">
                {i + 1}
              </span>
              <h3 class="font-bold text-lg text-[var(--text)] mb-2">{p.title}</h3>
              <p class="text-sm text-[var(--text-muted)] max-w-xs">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA propietarios -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-400 to-brand-500 px-8 py-14 sm:px-14"
    >
      <div class="relative max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-ink-900 mb-4">
          ¿Tienes un espacio sin uso?
        </h2>
        <p class="text-ink-900/80 text-lg mb-8">
          Publícalo gratis. Solo cobramos una comisión cuando conseguimos
          alquilarlo. Sin cuotas, sin permanencia.
        </p>
        <a
          href={url('publica-tu-espacio')}
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-ink-900 text-white font-bold transition hover:bg-ink-800"
        >
          <Icon aria-hidden="true" name="lucide:plus-circle" class="w-5 h-5" />
          Publicar mi espacio
        </a>
      </div>
      <Icon
        aria-hidden="true"
        name="lucide:building-2"
        class="absolute -right-8 -bottom-8 w-56 h-56 text-ink-900/10"
      />
    </div>
  </section>
</Base>
