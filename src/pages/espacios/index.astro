---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import EspacioCard from '../../components/EspacioCard.astro';
import { ISLAS, TIPOS, TIPO_LABEL } from '../../content.config';

const espacios = (await getCollection('espacios', ({ data }) => !data.draft)).sort(
  (a, b) => {
    // Disponibles primero, luego por orden.
    if (a.data.disponible !== b.data.disponible) return a.data.disponible ? -1 : 1;
    return a.data.orden - b.data.orden;
  },
);

// Solo mostramos en los filtros las islas/tipos que realmente tienen espacios.
const islasConEspacios = ISLAS.filter((isla) =>
  espacios.some((e) => e.data.isla === isla),
);
const tiposConEspacios = TIPOS.filter((tipo) =>
  espacios.some((e) => e.data.tipo === tipo),
);
---

<Base
  title="Espacios en alquiler en Canarias"
  description="Explora oficinas, salas, locales y coworkings disponibles en todas las islas Canarias. Filtra por isla y tipo de espacio."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-8">
      <h1 class="text-4xl font-extrabold text-[var(--text)] mb-3">Espacios disponibles</h1>
      <p class="text-[var(--text-muted)]">
        <span id="count">{espacios.length}</span>
        {espacios.length === 1 ? ' espacio' : ' espacios'} en las islas Canarias.
      </p>
    </header>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-3 mb-8 p-4 rounded-2xl bg-[var(--surface-2)] border border-[var(--card-border)]">
      <div class="flex flex-col gap-1.5 flex-1 min-w-[160px]">
        <label for="f-isla" class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wide">Isla</label>
        <select
          id="f-isla"
          class="px-3.5 py-2.5 rounded-lg border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] outline-none focus:border-brand-400 transition"
        >
          <option value="">Todas las islas</option>
          {islasConEspacios.map((isla) => <option value={isla}>{isla}</option>)}
        </select>
      </div>
      <div class="flex flex-col gap-1.5 flex-1 min-w-[160px]">
        <label for="f-tipo" class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wide">Tipo</label>
        <select
          id="f-tipo"
          class="px-3.5 py-2.5 rounded-lg border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] outline-none focus:border-brand-400 transition"
        >
          <option value="">Todos los tipos</option>
          {tiposConEspacios.map((tipo) => <option value={tipo}>{TIPO_LABEL[tipo]}</option>)}
        </select>
      </div>
      <div class="flex items-end">
        <button
          id="f-reset"
          type="button"
          class="px-4 py-2.5 rounded-lg text-sm font-medium text-[var(--text-soft)] hover:bg-[var(--card)] transition"
        >
          Limpiar
        </button>
      </div>
    </div>

    <!-- Grid -->
    <div id="grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        espacios.map((espacio) => (
          <div class="espacio-item" data-isla={espacio.data.isla} data-tipo={espacio.data.tipo}>
            <EspacioCard espacio={espacio} />
          </div>
        ))
      }
    </div>

    <!-- Sin resultados -->
    <div id="empty" class="hidden text-center py-20">
      <Icon name="lucide:search-x" class="w-12 h-12 mx-auto text-[var(--text-muted)] mb-4" />
      <p class="text-[var(--text-soft)] font-medium mb-1">No hay espacios con esos filtros.</p>
      <p class="text-sm text-[var(--text-muted)]">Prueba a quitar algún filtro o limpia la búsqueda.</p>
    </div>
  </div>
</Base>

<script>
  const fIsla = document.getElementById('f-isla') as HTMLSelectElement;
  const fTipo = document.getElementById('f-tipo') as HTMLSelectElement;
  const fReset = document.getElementById('f-reset');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.espacio-item'));
  const count = document.getElementById('count');
  const empty = document.getElementById('empty');
  const grid = document.getElementById('grid');

  function apply() {
    const isla = fIsla.value;
    const tipo = fTipo.value;
    let visible = 0;
    items.forEach((item) => {
      const ok =
        (!isla || item.dataset.isla === isla) && (!tipo || item.dataset.tipo === tipo);
      item.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    if (count) count.textContent = String(visible);
    empty?.classList.toggle('hidden', visible > 0);
    grid?.classList.toggle('hidden', visible === 0);
  }

  fIsla?.addEventListener('change', apply);
  fTipo?.addEventListener('change', apply);
  fReset?.addEventListener('click', () => {
    fIsla.value = '';
    fTipo.value = '';
    apply();
  });
</script>
