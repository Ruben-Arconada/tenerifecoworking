---
import { Icon } from 'astro-icon/components';
import { url, asset } from '../lib/url';
import { formatPrecio } from '../lib/format';
import { TIPO_LABEL, TIPO_LABEL_EN } from '../content.config';
import type { Lang } from '../lib/i18n';

interface Props {
  espacio: {
    id: string;
    data: {
      title: string;
      description: string;
      isla: string;
      municipio: string;
      zona?: string;
      tipo: keyof typeof TIPO_LABEL;
      capacidad?: number;
      superficie?: number;
      precio?: number;
      precioPeriodo?: string;
      precioDesde?: boolean;
      imagenPrincipal?: string;
      imagenAlt?: string;
      disponible?: boolean;
    };
  };
  lang?: Lang;
}

const { espacio, lang = 'es' } = Astro.props;
const d = espacio.data;
// Las fichas son solo ES por ahora; desde el catálogo EN se enlaza a la ficha ES.
const href = url(`espacios/${espacio.id}`);

const tipoLabel = (lang === 'en' ? TIPO_LABEL_EN : TIPO_LABEL)[d.tipo];
const notAvailable = lang === 'en' ? 'Not available' : 'No disponible';

// Icono representativo según el tipo de espacio.
const TIPO_ICON: Record<string, string> = {
  oficina: 'lucide:building-2',
  despacho: 'lucide:door-open',
  'sala-reuniones': 'lucide:users',
  coworking: 'lucide:laptop',
  'local-comercial': 'lucide:store',
  nave: 'lucide:warehouse',
  'espacio-eventos': 'lucide:party-popper',
  otro: 'lucide:map-pin',
};
const icon = TIPO_ICON[d.tipo] ?? 'lucide:map-pin';
---

<a
  href={href}
  class="group flex flex-col rounded-2xl overflow-hidden border border-[var(--card-border)] bg-[var(--card)] transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-400/10"
>
  <!-- Imagen o placeholder con color de marca -->
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-100">
    {
      d.imagenPrincipal ? (
        <img
          src={asset(d.imagenPrincipal)}
          alt={d.imagenAlt ?? d.title}
          class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full grid place-items-center bg-gradient-to-br from-brand-200 to-brand-400">
          <Icon aria-hidden="true" name={icon} class="w-14 h-14 text-brand-800/40" />
        </div>
      )
    }
    <span
      class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-[var(--card)]/90 backdrop-blur text-xs font-semibold text-[var(--text-soft)]"
    >
      {tipoLabel}
    </span>
    {
      d.disponible === false && (
        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-ink-900/80 text-xs font-semibold text-white">
          {notAvailable}
        </span>
      )
    }
  </div>

  <!-- Cuerpo -->
  <div class="flex flex-col flex-1 p-4">
    <div class="flex items-center gap-1 text-xs text-[var(--text-muted)] mb-1.5">
      <Icon aria-hidden="true" name="lucide:map-pin" class="w-3.5 h-3.5" />
      <span>{d.municipio}{d.zona ? `, ${d.zona}` : ''} · {d.isla}</span>
    </div>

    <h3 class="font-display font-bold text-[var(--text)] leading-snug mb-2 group-hover:text-[var(--accent-strong)] transition">
      {d.title}
    </h3>

    <p class="text-sm text-[var(--text-muted)] line-clamp-2 mb-4">{d.description}</p>

    <!-- Meta -->
    <div class="mt-auto flex items-center justify-between">
      <div class="flex items-center gap-3 text-xs text-[var(--text-muted)]">
        {
          d.capacidad && (
            <span class="flex items-center gap-1">
              <Icon aria-hidden="true" name="lucide:users" class="w-3.5 h-3.5" />
              {d.capacidad}
              <span class="sr-only">{lang === 'en' ? 'people' : 'personas'}</span>
            </span>
          )
        }
        {
          d.superficie && (
            <span class="flex items-center gap-1">
              <Icon aria-hidden="true" name="lucide:ruler" class="w-3.5 h-3.5" />
              {d.superficie} m²
            </span>
          )
        }
      </div>
      <span class="text-sm font-bold text-[var(--accent-strong)]">
        {formatPrecio(d.precio, d.precioPeriodo, d.precioDesde, lang)}
      </span>
    </div>
  </div>
</a>
