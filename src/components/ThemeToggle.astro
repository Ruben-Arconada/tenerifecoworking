---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const label =
  lang === 'en' ? 'Switch between light and dark mode' : 'Cambiar entre modo claro y oscuro';
---

<button
  type="button"
  id="theme-toggle"
  class="grid place-items-center w-10 h-10 rounded-full border border-[var(--card-border)] bg-[var(--card)] text-[var(--text)] cursor-pointer transition hover:border-brand-400 hover:scale-105 active:scale-95"
  aria-label={label}
>
  <Icon aria-hidden="true" name="lucide:sun" class="w-5 h-5 icon-sun" />
  <Icon aria-hidden="true" name="lucide:moon" class="w-5 h-5 icon-moon" />
</button>

<style>
  /* El JS del Base layout garantiza data-theme siempre seteado. */
  .icon-sun,
  .icon-moon {
    display: none;
  }
  :global([data-theme='light']) .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    document
      .getElementById('meta-theme-color')
      ?.setAttribute('content', next === 'dark' ? '#100d09' : '#fbbf2d');
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>
