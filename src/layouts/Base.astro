---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/url';
import { OG_LOCALE, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Imagen para Open Graph (ruta en /public). Por defecto el logo. */
  image?: string;
  /** Forzar noindex aunque estemos en producción (p. ej. /gracias/). */
  noindex?: boolean;
  /** Idioma de la página. ES por defecto. */
  lang?: Lang;
  /** URL (con base) de esta misma página en el otro idioma → hreflang + switcher. */
  altHref?: string;
}

const { title, description, image, noindex = false, lang = 'es', altHref } = Astro.props;
const altLang: Lang = lang === 'es' ? 'en' : 'es';

// En cualquier entorno que no sea producción, noindex global.
const isProd = import.meta.env.TNF_IS_PROD;
const robots = !isProd || noindex ? 'noindex, follow' : 'index, follow';

// Canonical absoluto (respeta site + ruta actual).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altAbs = altHref ? new URL(altHref, Astro.site).href : undefined;
const ogImage = new URL(asset(image ?? 'og-default.png'), Astro.site).href;

const skipLabel = lang === 'en' ? 'Skip to content' : 'Saltar al contenido';

const fullTitle = title.includes('Tenerife Coworking')
  ? title
  : `${title} · Tenerife Coworking`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      altAbs && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang={altLang} href={altAbs} />
          <link rel="alternate" hreflang="x-default" href={lang === 'es' ? canonical : altAbs} />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {altAbs && <meta property="og:locale:alternate" content={OG_LOCALE[altLang]} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Tema del navegador: el script anti-FOUC y el toggle lo mantienen
         sincronizado con data-theme (localStorage manda sobre el sistema). -->
    <meta name="theme-color" id="meta-theme-color" content="#fbbf2d" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />

    <!-- Anti-FOUC: setea data-theme antes de pintar. Siempre 'light' o 'dark'. -->
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            theme = stored;
          } else if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches
          ) {
            theme = 'dark';
          }
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#100d09' : '#fbbf2d');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-brand-400 focus:text-[var(--on-accent)] focus:font-bold"
    >
      {skipLabel}
    </a>
    <Header lang={lang} altHref={altHref} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
