# Copia este archivo a .env y rellena los valores reales.
# .env está gitignored — nunca se commitea.

# Webhook de n8n que recibe los leads de formularios.
# Lo creas en n8n.clickcomunicacion.com (nodo Webhook, modo Production).
PUBLIC_N8N_WEBHOOK_URL="https://n8n.clickcomunicacion.com/webhook/tnf-lead"

# Cloudflare Turnstile (anti-spam invisible). Site key es pública.
# La secret key va en n8n (para verificar el token server-side), no aquí.
PUBLIC_TURNSTILE_SITE_KEY=""
